# ============================================
# DUSOLAI - Local Environment Variables
# ============================================
# Copia este fichero a .env.local y rellena los valores.
# .env.local esta en .gitignore: NUNCA se sube al repo.

VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Settings > API Keys > Publishable key (esta es publica por diseno:
# viaja en el bundle del frontend. Tu seguridad real es RLS activado).
VITE_SUPABASE_ANON_KEY="..."

# Google AI Studio. SECRETA: nunca en el repo.
VITE_GEMINI_API_KEY="..."
